# Copia este archivo como ".env" (sin la palabra ejemplo) y completa los valores.
# El archivo .env está en .gitignore: nunca se sube a GitHub.

# Clave que firma las sesiones (cualquier texto largo y aleatorio)
HDD_SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio

# App registrada en Microsoft Entra (Registros de aplicaciones)
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=

# Debe coincidir exactamente con el URI de redirección registrado en Entra
MS_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback

# Dominio cuyas cuentas pueden entrar como RRHH
RRHH_DOMINIO=keyinstitute.edu.sv

# ---- Solo para publicar en un hosting (alwaysdata). En XAMPP se dejan comentadas. ----
# HDD_ENTORNO=nube
# DB_HOST=mysql-TU-CUENTA.alwaysdata.net
# DB_USUARIO=
# DB_PASSWORD=
# DB_NOMBRE=
# En la nube el URI de Microsoft usa HTTPS, por ejemplo:
# MS_REDIRECT_URI=https://TU-CUENTA.alwaysdata.net/auth/microsoft/callback
